# ---------------------------------------------------------------------------
# Production settings for Vision International School.
#
# Copy to .env on the server and fill in the marked values. Run
# `php artisan deploy:check` afterwards — it verifies most of this file and
# refuses to pass while anything here is still pointing at a developer's laptop.
# ---------------------------------------------------------------------------

APP_NAME="Vision International School"
APP_ENV=production
# Off. A stack trace shows file paths, queries and config values to whoever
# triggered the error.
APP_DEBUG=false
# Generate on the server with: php artisan key:generate
APP_KEY=
# The address the school actually visits, with https.
APP_URL=https://school.example.ly

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Tripoli

# ---- logs -----------------------------------------------------------------
# Daily, not single: one file that never rotates grows without limit.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ---- database --------------------------------------------------------------
# MySQL 8.0+ or MariaDB 10.2+ — the classroom stream uses a window function.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vis_school
DB_USERNAME=
DB_PASSWORD=

# ---- session and sign-in ----------------------------------------------------
# The SPA authenticates with an HttpOnly cookie, so these three decide whether
# anyone can sign in at all.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# A leading dot covers subdomains; drop it if the app has just the one host.
SESSION_DOMAIN=.school.example.ly
# Never send the session cookie over plain http.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The hosts the SPA is served from. Sign-in fails silently when this is wrong.
SANCTUM_STATEFUL_DOMAINS=school.example.ly
FRONTEND_URLS=https://school.example.ly

# ---- mail ------------------------------------------------------------------
# Needed for anything that emails. Until it is set, MAIL_MAILER=log writes to
# the log file instead of sending.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@school.example.ly
MAIL_FROM_NAME="${APP_NAME}"

# ---- queues and cache -------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- first administrator ----------------------------------------------------
# Read by the seeder on a fresh install. Leave it out and a strong password is
# generated and printed once instead.
SEED_ADMIN_PASSWORD=

# ---- Classroom attachments ---------------------------------------------------
# A private disk. Never `public`, or every class file is one guessed URL away.
CLASSROOM_DISK=local
CLASSROOM_MAX_UPLOAD_KB=20480
CLASSROOM_MAX_FILES_PER_POST=10
CLASSROOM_PAGE_SIZE=20

# ---- Google Classroom --------------------------------------------------------
# See docs/google-classroom.md. The path of the key file, never the key itself.
GOOGLE_CLASSROOM_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_IMPERSONATE_EMAIL=
