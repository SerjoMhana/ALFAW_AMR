# Defence in depth: backend/ and frontend/ each carry their own ignore rules,
# and these repeat the ones that matter most in case a stray copy of a secret
# or of the school's data is ever dropped somewhere else in the tree.

# Credentials and environment
.env
.env.*
# Templates carry placeholders and the deploy instructions, never a secret.
!.env.example
!.env.*.example
*.pem
*.key
*service-account*.json

# The school's data: never in version control
*.sqlite
*.sqlite3
*.sql
*.sql.gz

# Dependencies and build output
/node_modules
/vendor

# Editors and machines
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code machine-local settings
.claude/settings.local.json
